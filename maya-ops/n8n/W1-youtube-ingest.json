              "field": "seconds",
              "secondsInterval": 5
            }
          ]
        }
      },
      "id": "w1-trigger",
      "name": "Every 5s",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -528,
        304
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "maya_api",
              "value": "https://dwf0fjen86bz6x-8000.proxy.runpod.net",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "w2_webhook",
              "value": "https://rafa5555.app.n8n.cloud/webhook/maya-chat",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "w1-config",
      "name": "CONFIG",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -320,
        304
      ]
    },
    {
      "parameters": {
        "url": "https://www.googleapis.com/youtube/v3/liveBroadcasts",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "youTubeOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "part",
              "value": "snippet"
            },
            {
              "name": "broadcastStatus",
              "value": "active"
            },
            {
              "name": "broadcastType",
              "value": "all"
            }
          ]
        },
        "options": {}
      },
      "id": "w1-broadcast",
      "name": "Find active broadcast",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -128,
        304
      ],
      "credentials": {
        "youTubeOAuth2Api": {
          "id": "CwHRctOA9ONJ8dat",
          "name": "YouTube account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// The liveChatId belongs to the broadcast and does not change while it runs, so it is\n// cached in static data. If the broadcast has not started, we stop QUIETLY here rather\n// than hammering the messages endpoint with an empty id and burning quota.\nconst staticData = $getWorkflowStaticData('global');\nconst items = $input.all();\nconst live = items[0]?.json?.items?.[0];\nconst chatId = live?.snippet?.liveChatId || staticData.liveChatId;\nif (!chatId) return [];\nstaticData.liveChatId = chatId;\nreturn [{ json: { liveChatId: chatId, pageToken: staticData.pageToken || '' } }];"
      },
      "id": "w1-chatid",
      "name": "Resolve liveChatId",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        304
      ]
    },
    {
      "parameters": {
        "url": "https://www.googleapis.com/youtube/v3/liveChat/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "youTubeOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "part",
              "value": "snippet,authorDetails"
            },
            {
              "name": "liveChatId",
              "value": "={{ $json.liveChatId }}"
            },
            {
              "name": "pageToken",
              "value": "={{ $json.pageToken }}"
            },
            {
              "name": "maxResults",
              "value": "200"
            }
          ]
        },
        "options": {}
      },
      "id": "w1-messages",
      "name": "liveChatMessages.list",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        288,
        304
      ],
      "credentials": {
        "youTubeOAuth2Api": {
          "id": "CwHRctOA9ONJ8dat",
          "name": "YouTube account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Diff against what we have already forwarded. The API replays a window of messages on\n// every poll, so WITHOUT this de-dupe Maya answers the same viewer every 5 seconds — the\n// single most obvious way an AI host looks broken on a live stream.\nconst staticData = $getWorkflowStaticData('global');\nconst seen = new Set(staticData.seenIds || []);\nconst res = $input.first().json;\nstaticData.pageToken = res.nextPageToken || '';\n\nconst out = [];\nfor (const m of (res.items || [])) {\n  const id = m.id;\n  if (!id || seen.has(id)) continue;\n  seen.add(id);\n  const text = m.snippet?.displayMessage || m.snippet?.textMessageDetails?.messageText || '';\n  if (!text.trim()) continue;\n  out.push({ json: {\n    platform: 'youtube',\n    msg_id: id,\n    name: m.authorDetails?.displayName || 'viewer',\n    handle: m.authorDetails?.channelId || '',\n    text: text.trim(),\n    ts: m.snippet?.publishedAt || new Date().toISOString(),\n  }});\n}\n// keep the seen-set bounded: a long stream must not grow memory without limit\nstaticData.seenIds = Array.from(seen).slice(-2000);\nreturn out;"
      },
      "id": "w1-new",
      "name": "New messages only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('CONFIG').first().json.w2_webhook }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messages: $input.all().map(i => i.json) }) }}",
        "options": {}
      },
      "id": "w1-tow2",
      "name": "→ W2 (batch)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        704,
        304
      ],
      "executeOnce": true
    }
  ],
  "connections": {
