        "jsCode": "// Reads the webhook body directly so the CONFIG Set node can't strip the message.\nconst TRIGGERS = ['אני רוצה', 'רוצה את', 'רוצה', 'לקנות', 'איך מזמינים', 'i want', 'want it', 'buy', 'how do i order', 'order'];\nconst wh = $('Webhook').first().json;\nconst j = (wh && wh.body) || $input.first().json.body || $input.first().json;\nconst text = String(j.text || '').toLowerCase();\nconst hit = TRIGGERS.some(t => text.includes(t.toLowerCase()));\nif (j.priority !== 'buy_intent' && !hit) return [];\nreturn [{ json: {\n  ts: new Date().toISOString(),\n  platform: j.platform || 'youtube',\n  name: j.name || 'viewer',\n  handle: j.handle || '',\n  product: j.product || '',\n  message: j.text || '',\n}}];"
