# /workspace/.env — TEMPLATE (never commit the real one; it stays on the pod volume only)
# Every key-bearing script on the volume should source this instead of hardcoding:
#     set -a; . /workspace/.env; set +a
# Applies to: boot.sh, maya-boot.sh, bake.sh, bake_master.sh (and any bakejob.sh).

# --- live avatar / brain ---
OPENAI_API_KEY=sk-REPLACE_ME
# Hume EVI (voice backend, if VOICE_BACKEND=hume)
HUME_API_KEY=REPLACE_ME
HUME_CONFIG_ID=REPLACE_ME

# --- LiveKit (bridge/room) ---
LIVEKIT_URL=wss://REPLACE_ME
LIVEKIT_API_KEY=REPLACE_ME
LIVEKIT_API_SECRET=REPLACE_ME
# Room is set per-avatar by the boot script (Nova=nova-live, Maya forces maya-live) — not here.

# --- bake / pod control (used by bake.sh, bake_master.sh) ---
# bake.sh currently reads /workspace/.oai_key -> switch it to OPENAI_API_KEY above.
# bake_master.sh currently hardcodes K="rpa_..." -> switch it to RUNPOD_API_KEY below.
RUNPOD_API_KEY=rpa_REPLACE_ME

# NOTE: the pod-side refactor (strip inline keys from the *.sh, source this .env)
# happens in the next pod session — see ROTATION_CHECKLIST.md.
