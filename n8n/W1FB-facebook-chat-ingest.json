{
  "name": "MAYA W1-FB — Facebook Live chat ingest",
  "meta": {
    "why": "The Meta ear (product map L-ears; strategy: LIVE = Meta + YouTube). Same pattern as W1: poll the platform's live chat, forward only NEW normalized messages to W2. Built in advance, INACTIVE — needs the founder's Facebook credential later. Proves 'new channel = new ear'.",
    "setup": "1) Attach a Facebook Graph API credential to both HTTP nodes. 2) CONFIG.page_id = the client's Facebook Page id, CONFIG.w2_webhook = W2's production URL. 3) Page must be LIVE (a live_video with status LIVE) — the poll resolves it and caches the id. 4) Activate only after W2 is active.",
    "polling": "5s, same as W1. Graph API live comments endpoint: /{live_video_id}/comments with live_filter."
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 5
            }
          ]
        }
      },
      "id": "fb-trigger",
      "name": "Every 5s",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -520,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "page_id",
              "value": "PUT-CLIENT-PAGE-ID-HERE",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "w2_webhook",
              "value": "https://rafa5555.app.n8n.cloud/webhook/maya-chat",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "fb-config",
      "name": "CONFIG",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -320,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://graph.facebook.com/v26.0/{{ $json.page_id }}/live_videos",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "facebookGraphApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,status"
            },
            {
              "name": "broadcast_status",
              "value": "[\"LIVE\"]"
            }
          ]
        },
        "options": {}
      },
      "id": "fb-live",
      "name": "Find live video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -120,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Cache the live video id like W1 caches liveChatId; stop QUIETLY when not live.\nconst staticData = $getWorkflowStaticData('global');\nconst live = ($input.first().json.data || []).find(v => v.status === 'LIVE');\nconst vid = live?.id || staticData.liveVideoId;\nif (!vid) return [];\nstaticData.liveVideoId = vid;\nreturn [{ json: { video_id: vid } }];"
      },
      "id": "fb-vid",
      "name": "Resolve video id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://graph.facebook.com/v26.0/{{ $json.video_id }}/comments",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "facebookGraphApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,from{name,id},message,created_time"
            },
            {
              "name": "live_filter",
              "value": "filter_low_quality"
            },
            {
              "name": "order",
              "value": "reverse_chronological"
            },
            {
              "name": "limit",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "fb-comments",
      "name": "Fetch comments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Same replay-window dedupe as W1 — without it she answers the same viewer every 5s.\nconst staticData = $getWorkflowStaticData('global');\nconst seen = new Set(staticData.fbSeenIds || []);\nconst out = [];\nfor (const c of ($input.first().json.data || [])) {\n  if (!c.id || seen.has(c.id)) continue;\n  seen.add(c.id);\n  const text = String(c.message || '').trim();\n  if (!text) continue;\n  out.push({ json: {\n    platform: 'facebook',\n    msg_id: c.id,\n    name: c.from?.name || 'viewer',\n    handle: c.from?.id || '',\n    text,\n    ts: c.created_time || new Date().toISOString(),\n  }});\n}\nstaticData.fbSeenIds = Array.from(seen).slice(-2000);\nreturn out;"
      },
      "id": "fb-new",
      "name": "New messages only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('CONFIG').first().json.w2_webhook }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messages: $input.all().map(i => i.json) }) }}",
        "options": {}
      },
      "id": "fb-tow2",
      "name": "→ W2 (batch)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        300
      ],
      "executeOnce": true
    }
  ],
  "connections": {
    "Every 5s": {
      "main": [
        [
          {
            "node": "CONFIG",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CONFIG": {
      "main": [
        [
          {
            "node": "Find live video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find live video": {
      "main": [
        [
          {
            "node": "Resolve video id",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resolve video id": {
      "main": [
        [
          {
            "node": "Fetch comments",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch comments": {
      "main": [
        [
          {
            "node": "New messages only",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "New messages only": {
      "main": [
        [
          {
            "node": "→ W2 (batch)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "maya"
    }
  ]
}
