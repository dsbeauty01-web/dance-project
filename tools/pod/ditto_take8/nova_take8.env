# nova_take8.env -- the Maya "Seyzar take 8" Ditto recipe, as it applies to Nova.
# Source of every value: maya-lt lane/motion-transfer @ 7d07a9f, shows/seyzar-live8.json (the take
# that measured corr 0.701 / speaking 2.73 / 0 open / 0 pucker), unless a line says otherwise.
# Use:  set -a; . tools/pod/ditto_take8/nova_take8.env; set +a
#       DITTO_SRC=/path/body.mp4 bash tools/pod/ditto_take8/ditto_up.sh
# NOT RUN ON A POD YET (2026-11-10: no RunPod key in the session). Evidence: docs/nova-ditto/take8/.

# --- the engine contract (unchanged from Nova's known-good set, ditto-for-nova skill) ---
DITTO_CHUNK=25
DITTO_PRIME=35
DITTO_VAD=1
DITTO_THREADS=6
DITTO_EYE_HOLD=1
DITTO_WAIT_SEC=1500
DITTO_PORT=8031

# --- take 8 ---
DITTO_GRAIN=0            # take 8: no synthetic grain on the redrawn mouth
DITTO_MASK=lower         # the mission's value. (seyzar-live8.json itself runs "lips" + DITTO_LIP_LAB measured
                         # from his own lips; Nova has no measured lip colour yet -> QUESTION, stay on lower.)
DITTO_PASTE_GATE=1       # in silence her OWN closed mouth plays, Ditto is not pasted (take 5: open-in-silence 32 -> 0)
DITTO_PASTE_OFF_MS=80
DITTO_PASTE_XFADE_MS=120
DITTO_ON_RMS=0.012
DITTO_GATE=1             # NOT WIRED FOR NOVA: in Maya this is done by the shim (drive_gate.py cleans the whole TTS
                         # line that drives the lips before it reaches Ditto). Nova's voice is a live stream with no
                         # "whole line", and nova_ditto.py does not gate it. Setting it here changes nothing today.
                         # drive_gate.py is copied beside this file for the session that wires a streaming version.
DITTO_FAST_CLOSE=1       # the mouth closes when the sound stops (take 4). Written for the gated drive audio above;
                         # on Nova's ungated stream it relies on DITTO_ON_RMS alone -- to be checked on the pod.
DITTO_DEBT_FIX=1
DITTO_FAST_PRIME=1       # boot fix 2026-11-05: do not sit out the 120 s prime wait
DITTO_STATS_EVERY=10
# DITTO_OUT_W / DITTO_OUT_H are deliberately NOT set: 0 = the body's own size. Never deliver a 720 px cut of a
# 1080 source (it halves face sharpness -- maya-lips skill). NOTE the conflict: Nova's live bridge downsizes the
# publish to 720x1288 on purpose (beta 408c71f, bitrate starvation at 3 Mbit). QUESTION for the founder: raise the
# bitrate and publish 1080, or accept the softer face live. Offline renders (the intro clip) are not affected.

# --- the one take-8 value that is NOT copied ---
DITTO_AMP=0.6            # take 8 used 1.0 -- for a man whose beard hides his mouth. Nova at 0.6 already moves her lips
                         # MORE than take 8: speaking lip motion 3.43 vs 2.72 (docs/nova-ditto/take8/numbers/
                         # beta_arrival_clip.json vs ref_take8.json). 1.0 would overshoot. QUESTION: A/B 0.6 vs 0.8 on a pod.

# --- pod boot (maya-lt deploy/small/prof_job.sh, 2026-11-10) ---
# apt stalled > 300 s on 3 pods on 2026-11-09. Do not wait for apt's ffmpeg: fetch the static build (12 s):
#   curl -fsSL -m 240 https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-linux64-gpl.tar.xz \
#     | tar -xJ --strip-components=2 -C /usr/local/bin --wildcards '*/bin/ffmpeg' '*/bin/ffprobe'
MAYA_FFMPEG_STATIC=1
